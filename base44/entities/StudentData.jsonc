{
  "name": "StudentData",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the student this data belongs to"
    },
    "topics": {
      "type": "object",
      "description": "Per-topic attempt data keyed by topic key (Physics)",
      "additionalProperties": true
    },
    "written_review_bank": {
      "type": "array",
      "description": "Physics written questions awaiting review (formerly review_bank)",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "review_bank": {
      "type": "array",
      "description": "Legacy field \u2014 migrated to written_review_bank on load",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "review_bank_clears": {
      "type": "number",
      "default": 0
    },
    "mcq_attempts": {
      "type": "array",
      "description": "All Physics MCQ attempt records",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "mcq_review_bank": {
      "type": "array",
      "description": "Physics MCQ questions flagged for review (formerly guess_review_bank)",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "guess_review_bank": {
      "type": "array",
      "description": "Legacy field \u2014 migrated to mcq_review_bank on load",
      "items": {
        "type": "string"
      }
    },
    "cs_data": {
      "type": "object",
      "description": "All Computer Science attempt data for this student",
      "additionalProperties": true,
      "default": {
        "topics": {},
        "cs_review_bank": [],
        "cs_guess_review_bank": [],
        "cs_mcq_attempts": []
      }
    },
    "global_streak": {
      "type": "number",
      "default": 0,
      "description": "Number of consecutive days with 3+ questions answered"
    },
    "global_streak_last_date": {
      "type": "string",
      "description": "Date string (dd/mm/yyyy) when streak was last incremented"
    },
    "rest_day_passes": {
      "type": "number",
      "default": 0,
      "description": "Number of rest day passes held (max 1)"
    },
    "daily_question_count": {
      "type": "object",
      "description": "{ date: string, count: number } \u2014 resets each day",
      "additionalProperties": true
    },
    "last_session_time": {
      "type": "string",
      "description": "ISO timestamp of last app open"
    },
    "exam_sessions": {
      "type": "array",
      "description": "Past paper exam session records",
      "items": {
        "type": "object",
        "properties": {
          "paper": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "date_started": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "time_remaining_seconds": {
            "type": "number"
          },
          "current_question_index": {
            "type": "number"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_id": {
                  "type": "string"
                },
                "answer_text": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "total_marks": {
                  "type": "number"
                },
                "skipped": {
                  "type": "boolean"
                },
                "flagged": {
                  "type": "boolean"
                },
                "ai_feedback": {
                  "type": "string"
                },
                "mark_scheme": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "total_score": {
            "type": "number"
          },
          "total_marks": {
            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "default": []
    }
  },
  "required": [
    "user_email"
  ]
}