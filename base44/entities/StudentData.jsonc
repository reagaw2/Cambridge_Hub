{
  "name": "StudentData",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the student this data belongs to"
    },
    "topics": {
      "type": "object",
      "description": "Per-topic attempt data keyed by topic key (Physics)",
      "additionalProperties": true
    },
    "review_bank": {
      "type": "array",
      "description": "Physics questions awaiting review",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "review_bank_clears": {
      "type": "number",
      "default": 0
    },
    "mcq_attempts": {
      "type": "array",
      "description": "All Physics MCQ attempt records",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "guess_review_bank": {
      "type": "array",
      "description": "Physics question IDs flagged as guesses",
      "items": {
        "type": "string"
      }
    },
    "cs_data": {
      "type": "object",
      "description": "All Computer Science attempt data for this student",
      "additionalProperties": true,
      "default": {
        "topics": {},
        "cs_review_bank": [],
        "cs_guess_review_bank": [],
        "cs_mcq_attempts": []
      }
    }
  },
  "required": [
    "user_email"
  ]
}