{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "preferred_name": {
      "type": "string",
      "description": "The name the student prefers to be called.",
      "maxLength": 20
    },
    "onboarding_completed": {
      "type": "boolean",
      "description": "Whether the student has completed the first-time onboarding screen.",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}