{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "preferred_name": {
      "type": "string",
      "description": "The name the student prefers to be called. If empty, falls back to first name from full_name.",
      "maxLength": 20
    }
  },
  "required": [
    "role"
  ]
}